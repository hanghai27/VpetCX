plugin_examples_weather#weather city(Hanoi), type(current) | weather city(Tokyo), type(forecast):|
weather_window_title#天気:|
weather_error_location#1～120文字の場所を入力してください。:|
weather_window_location_hint#都市、地区、または地域を入力:|
weather_window_search#場所を検索:|
weather_window_select_location#リストから場所を選択してください:|
